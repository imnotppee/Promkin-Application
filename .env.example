# Promkin Application Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT!

# Google Gemini API Key (สำหรับฟีเจอร์ AI แนะนำเมนูอาหาร)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Backend Base URLs (ถ้ามี REST API ภายนอก)
FOOD_API_KEY=YOUR_FOOD_API_KEY_HERE
FOOD_API_BASE_URL=https://api.spoonacular.com/recipes

# Firebase Environment
FIREBASE_PROJECT_ID=promkin-app
FIREBASE_STORAGE_BUCKET=promkin-app.appspot.com

