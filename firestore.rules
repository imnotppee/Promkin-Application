rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function ownsMealPlan(planId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/meal_plans/$(planId))
        && get(/databases/$(database)/documents/meal_plans/$(planId)).data.user_id
          == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if signedInAs(userId);
      allow list: if false;
      allow create, update: if signedInAs(userId);
      allow delete: if false;
    }

    match /meal_plans/{planId} {
      allow get, list: if request.auth != null
        && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.user_id == request.auth.uid;
    }

    match /planned_meals/{mealId} {
      allow get, list, delete: if ownsMealPlan(resource.data.meal_plan_id);
      allow create: if ownsMealPlan(request.resource.data.meal_plan_id);
      allow update: if ownsMealPlan(resource.data.meal_plan_id)
        && request.resource.data.meal_plan_id == resource.data.meal_plan_id;
    }
  }
}
