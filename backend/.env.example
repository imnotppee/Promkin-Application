# PROM KIN Backend Environment Configuration
PORT=5000
NODE_ENV=development

# OpenAI API key for AI Meal Recommendations (store the real key in backend/.env)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6-luna

# TheMealDB API key (1 is the free development test key)
THEMEALDB_API_KEY=1

# Firebase Admin SDK Configuration (Optional / Phase 2)
FIREBASE_PROJECT_ID=promkin-app
